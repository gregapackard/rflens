[Unit]
Description=RFLens ADS-B readsb ingestor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Edit User, WorkingDirectory, and ExecStart for your install.
User=rflens
Group=rflens
WorkingDirectory=/opt/rflens
ExecStart=/opt/rflens/venv/bin/python -m backend.ingestors.adsb_readsb
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
