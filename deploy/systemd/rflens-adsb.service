[Unit]
Description=RF Lens ADS-B ingestor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rfnode/rflens
ExecStart=/home/rfnode/rflens/venv/bin/python -m backend.ingestors.adsb_readsb
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
