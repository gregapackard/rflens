[Unit]
Description=RF Lens API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rfnode/rflens
ExecStart=/home/rfnode/rflens/venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
