[Unit]
Description=RFLens API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Edit User and WorkingDirectory for your install.
User=rflens
Group=rflens
WorkingDirectory=/opt/rflens
ExecStart=/bin/bash /opt/rflens/scripts/run_api.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
