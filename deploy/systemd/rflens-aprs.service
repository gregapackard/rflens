[Unit]
Description=RF Lens APRS Direwolf log ingestor
After=rflens-aprs-radio.service
Requires=rflens-aprs-radio.service

[Service]
Type=simple
WorkingDirectory=/home/rfnode/rflens
ExecStart=/home/rfnode/rflens/venv/bin/python -m backend.ingestors.aprs_direwolf
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
