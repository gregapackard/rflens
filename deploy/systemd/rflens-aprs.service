[Unit]
Description=RFLens APRS Direwolf log ingestor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# This tails sources.aprs.log_path from config.yaml. Direwolf may be
# managed separately or by an optional local radio pipeline service.
User=rflens
Group=rflens
WorkingDirectory=/opt/rflens
ExecStart=/opt/rflens/venv/bin/python -m backend.ingestors.aprs_direwolf
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
